# Public web configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback during migration:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only database configuration
SUPABASE_SECRET_KEY=
# Optional legacy fallback during migration:
SUPABASE_SERVICE_ROLE_KEY=
# Optional; only needed by services that verify Supabase JWTs directly.
SUPABASE_JWKS_URL=
# Optional application runtime value; useful for CLI migration workflows.
DATABASE_URL=

# Muse Spark is the only active production model. Do not change META_MODEL_ID.
MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.1

# Apollo official remote MCP and OAuth 2.1 client
APOLLO_MCP_URL=https://mcp.apollo.io/mcp
# Optional REST API credential. It does not authenticate Apollo MCP.
APOLLO_API_KEY=
APOLLO_OAUTH_CLIENT_ID=
APOLLO_OAUTH_CLIENT_SECRET=
APOLLO_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/apollo/callback

# Generate ENCRYPTION_KEY with: openssl rand -base64 32
# Generate APPROVAL_SIGNING_SECRET with: openssl rand -hex 32
ENCRYPTION_KEY=
APPROVAL_SIGNING_SECRET=

# Search grounding
WEB_SEARCH_PROVIDER=meta
WEB_SEARCH_API_KEY=

# Worker and campaign guardrails
WORKER_CONCURRENCY=3
AGENT_MAX_TOOL_CALLS=40
AGENT_MAX_RUN_MINUTES=20
DEFAULT_DAILY_SEND_LIMIT=25
DEFAULT_APOLLO_CREDIT_BUDGET=100

# Development only. Both are rejected by the production environment validator.
MOCK_INTEGRATIONS=false
DEMO_MODE=false
LOG_LEVEL=info
