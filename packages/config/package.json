    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@marlow/shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
