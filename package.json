{
  "name": "marlow",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "demo": "DEMO_MODE=true MOCK_INTEGRATIONS=true NEXT_PUBLIC_APP_URL=http://localhost:4107 pnpm --filter @marlow/web exec next dev -p 4107",
    "build": "pnpm check:copy && turbo build",
    "lint": "pnpm check:copy && turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm check:copy && turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "pnpm --filter @marlow/web test:e2e",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check:copy": "node check-copy-style.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "next": "16.2.10",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
